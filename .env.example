MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=cortex_ai

REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=changeme

# Docker Compose provides this path via a runtime secret.
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase_service_account

FRONTEND_URL=http://localhost:5173

SESSION_COOKIE_NAME=session
ENVIRONMENT=development

GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=qwen/qwen3.6-27b
GOOGLE_API_KEY=your-google-api-key
TAVILY_API_KEY=your-tavily-api-key
QDRANT_URL=http://localhost:6333

# Pydantic Logfire Observability (Project: kaushalnepal12/multiagent-ai)
LOGFIRE_TOKEN=your-logfire-write-token
LOGFIRE_BASE_URL=https://logfire-us.pydantic.dev

# Token & LLM Limits
MAX_PROMPT_TOKENS=4000
LLM_TIMEOUT_SECONDS=30
# Separate timeout for streaming operations (longer to accommodate slow token generation)
LLM_STREAMING_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=3
SESSION_TTL_SECONDS=86400
